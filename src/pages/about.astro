---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutPhoto from '../assets/about-photo.jpg';
---

<BaseLayout
  title="About | Katherine Wong"
  description="Katherine Wong is a writer from California and Taiwan and a graduate of Stanford University's Symbolic Systems and Creative Writing programs."
>
  <section class="about-introduction" aria-labelledby="about-heading">
    <div class="about-copy">
      <h1 id="about-heading">About</h1>
      <p>
        Katherine Wong is a writer from California and Taiwan. She studied
        Symbolic Systems and Creative Writing at Stanford University, where she
        worked on fiction with a Wallace Stegner Fellow through Stanford's
        Levinthal Tutorial program. She is currently writing a novel.
      </p>
    </div>
    <Image
      src={aboutPhoto}
      alt="Katherine Wong seated on a staircase"
      width={704}
      format="webp"
      quality={85}
    />
  </section>
</BaseLayout>

<style>
  .about-introduction {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 22rem);
    align-items: start;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .about-copy {
    display: grid;
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  p {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: calc(-1 * clamp(3rem, 6vw, 5rem));
  }

  @media (max-width: 44rem) {
    .about-introduction {
      grid-template-columns: 1fr;
    }

    img {
      width: min(100%, 24rem);
      margin-top: 0;
    }
  }
</style>
