---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Katherine Wong"
  description="Contact writer Katherine Wong."
>
  <section class="contact" aria-labelledby="contact-heading">
    <h1 id="contact-heading">Contact</h1>
    <p>
      <a class="email-link" href="mailto:katherinewongwriting@gmail.com">
        <svg
          class="email-icon"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="2.75" y="5.25" width="18.5" height="13.5" rx="1.75" />
          <path d="m4 7 8 6 8-6" />
        </svg>
        <span>katherinewongwriting@gmail.com</span>
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  p {
    margin: 0;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.3em;
  }

  .email-icon {
    flex: none;
  }
</style>
