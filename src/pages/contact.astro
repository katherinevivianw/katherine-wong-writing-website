---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Katherine Wong"
  description="Contact Katherine Wong."
>
  <section class="contact" aria-labelledby="contact-heading">
    <h1 id="contact-heading">Contact</h1>
    <p>
      <a href="mailto:katherinewongwriting@gmail.com">
        katherinewongwriting@gmail.com
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  p {
    margin: 0;
  }

  p a {
    color: inherit;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.3em;
  }
</style>
