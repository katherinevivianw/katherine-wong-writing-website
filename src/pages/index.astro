---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout
  title="Katherine Wong"
  description="Katherine Wong is a writer from California and Taiwan currently writing a novel."
  showHeader={false}
  mainClass="home-main"
>
  <div class="home-index">
    <h1>
      <a class="home-wordmark" href="/" aria-label={`${site.name}, home`}>
        {site.name}
      </a>
    </h1>

    <nav class="home-navigation" aria-label="Primary navigation">
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/writing/">Writing</a></li>
        <li>
          <a
            href={site.storyGraphUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            StoryGraph
            <span class="external-mark" aria-hidden="true">↗</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .home-index {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(5rem, 12vh, 9rem);
    flex: 1;
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 9vh, 7rem);
  }

  ul {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    position: relative;
    color: inherit;
    font-size: var(--font-size-body);
    font-style: normal;
    font-weight: 400;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 150ms ease;
  }

  .home-wordmark {
    font-size: inherit;
    text-decoration: none;
  }

  .home-wordmark:hover {
    text-decoration: none;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  .external-mark {
    display: inline-block;
    margin-left: 0.12em;
    font-size: 0.78em;
    transform: translateY(-0.12em);
  }

  @media (max-width: 40rem) {
    .home-index {
      gap: clamp(4rem, 10vh, 6rem);
      padding-block: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
