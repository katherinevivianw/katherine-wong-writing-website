---
import { ClientRouter, fade } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SocialFooter from '../components/SocialFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  showHeader?: boolean;
  mainClass?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  showHeader = true,
  mainClass,
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  transition:name="page"
  transition:animate={fade({ duration: '180ms' })}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fdfcf8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Katherine Wong" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=gaegu:400"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showHeader && <SiteHeader />}
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <SocialFooter />
  </body>
</html>
